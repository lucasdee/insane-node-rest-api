{
  // The tests only ever run through Vitest, which loads them as ESM and resolves
  // imports like a bundler, so they are checked that way instead of with nodenext.
  "extends": "../../tsconfig.main.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "incremental": false,
    // The base rootDir is ./src, which would leave out vitest.config.mts.
    "rootDir": "../.."
  },
  "include": ["./**/*", "../../vitest.config.mts"],
  "exclude": []
}
