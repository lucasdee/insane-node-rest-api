{
	"openapi": "3.0.0",
	"components": {
		"examples": {},
		"headers": {},
		"parameters": {},
		"requestBodies": {},
		"responses": {},
		"schemas": {
			"UserSummary": {
				"description": "What other users may see of a user: enough to pick them, nothing private.",
				"properties": {
					"uuid": {
						"type": "string",
						"example": "123e4567-e89b-12d3-a456-426614174000"
					},
					"username": {
						"type": "string",
						"example": "jdoe"
					},
					"displayName": {
						"type": "string",
						"nullable": true,
						"example": "John Doe"
					}
				},
				"required": [
					"uuid",
					"username"
				],
				"type": "object",
				"additionalProperties": false
			},
			"User": {
				"properties": {
					"uuid": {
						"type": "string",
						"example": "123e4567-e89b-12d3-a456-426614174000"
					},
					"username": {
						"type": "string",
						"example": "admin"
					},
					"email": {
						"type": "string",
						"example": "admin@example.com"
					},
					"displayName": {
						"type": "string",
						"nullable": true,
						"example": "John Doe"
					},
					"role": {
						"type": "string",
						"enum": [
							"USER",
							"MOD",
							"ADMIN"
						],
						"example": "USER"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time",
						"example": "2024-01-01T00:00:00.000Z"
					}
				},
				"required": [
					"uuid",
					"username",
					"email",
					"role",
					"createdAt"
				],
				"type": "object",
				"additionalProperties": false
			},
			"TagCount": {
				"properties": {
					"name": {
						"type": "string",
						"example": "groceries"
					},
					"memoCount": {
						"type": "number",
						"format": "double",
						"description": "How many of the caller's memos carry the tag.",
						"example": 3
					}
				},
				"required": [
					"name",
					"memoCount"
				],
				"type": "object",
				"additionalProperties": false
			},
			"Memo": {
				"properties": {
					"uuid": {
						"type": "string",
						"example": "123e4567-e89b-12d3-a456-426614174000"
					},
					"title": {
						"type": "string",
						"example": "My first memo"
					},
					"content": {
						"type": "string",
						"example": "This is the content of my first memo."
					},
					"authorUuid": {
						"type": "string",
						"example": "5f0c1a2b-3c4d-4e5f-8a9b-0c1d2e3f4a5b"
					},
					"authorUsername": {
						"type": "string",
						"example": "alice"
					},
					"authorDisplayName": {
						"type": "string",
						"nullable": true,
						"description": "The author's display name, or null if they have not set one.",
						"example": "Alice"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time",
						"example": "2024-01-01T00:00:00.000Z"
					},
					"tags": {
						"items": {
							"type": "string"
						},
						"type": "array",
						"description": "The memo's tags, lowercased and sorted.",
						"example": [
							"groceries",
							"home"
						]
					}
				},
				"required": [
					"uuid",
					"title",
					"content",
					"authorUuid",
					"authorUsername",
					"authorDisplayName",
					"createdAt",
					"tags"
				],
				"type": "object",
				"additionalProperties": false
			},
			"MemoOnUser": {
				"properties": {
					"memoUuid": {
						"type": "string",
						"example": "123e4567-e89b-12d3-a456-426614174000"
					},
					"userUuid": {
						"type": "string",
						"example": "9b2d7c1e-4f3a-4b6c-9d8e-7f6a5b4c3d2e"
					},
					"assignedByUuid": {
						"type": "string",
						"example": "5f0c1a2b-3c4d-4e5f-8a9b-0c1d2e3f4a5b"
					},
					"assignedAt": {
						"type": "string",
						"format": "date-time",
						"example": "2024-01-01T00:00:00.000Z"
					},
					"role": {
						"type": "string",
						"enum": [
							"USER",
							"MOD",
							"ADMIN"
						],
						"example": "USER"
					},
					"memo": {
						"$ref": "#/components/schemas/Memo"
					}
				},
				"required": [
					"memoUuid",
					"userUuid",
					"assignedByUuid",
					"assignedAt",
					"role"
				],
				"type": "object",
				"additionalProperties": false
			},
			"TagName": {
				"type": "string",
				"description": "A tag name. It is stored lowercased, so \"Home\" and \"home\" are the same tag.",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
			},
			"MemoCreateRequest": {
				"properties": {
					"title": {
						"type": "string",
						"example": "My first memo",
						"minLength": 3,
						"maxLength": 128
					},
					"content": {
						"type": "string",
						"example": "This is the content of my first memo.",
						"minLength": 3,
						"maxLength": 10000
					},
					"tags": {
						"items": {
							"$ref": "#/components/schemas/TagName"
						},
						"type": "array",
						"description": "Tags to put on the memo. Duplicates (ignoring case) are merged.",
						"example": [
							"groceries",
							"home"
						],
						"maxItems": 10
					}
				},
				"required": [
					"title",
					"content"
				],
				"type": "object",
				"additionalProperties": false
			},
			"MemoAssignment": {
				"description": "A user a memo is assigned to, with their role on it and who assigned them.",
				"properties": {
					"userUuid": {
						"type": "string",
						"example": "9b2d7c1e-4f3a-4b6c-9d8e-7f6a5b4c3d2e"
					},
					"username": {
						"type": "string",
						"example": "bob"
					},
					"displayName": {
						"type": "string",
						"nullable": true,
						"description": "The assignee's display name, or null if they have not set one.",
						"example": "Bob"
					},
					"role": {
						"type": "string",
						"enum": [
							"USER",
							"MOD",
							"ADMIN"
						],
						"description": "The assignee's role on the memo, not their global role.",
						"example": "USER"
					},
					"assignedAt": {
						"type": "string",
						"format": "date-time",
						"example": "2024-01-01T00:00:00.000Z"
					},
					"assignedByUuid": {
						"type": "string",
						"example": "5f0c1a2b-3c4d-4e5f-8a9b-0c1d2e3f4a5b"
					},
					"assignedByUsername": {
						"type": "string",
						"example": "alice"
					},
					"assignedByDisplayName": {
						"type": "string",
						"nullable": true,
						"description": "The display name of whoever assigned the user, or null if they have not set one.",
						"example": "Alice"
					}
				},
				"required": [
					"userUuid",
					"username",
					"displayName",
					"role",
					"assignedAt",
					"assignedByUuid",
					"assignedByUsername",
					"assignedByDisplayName"
				],
				"type": "object",
				"additionalProperties": false
			},
			"MemoUpdateRequest": {
				"description": "Changes to a memo. Fields left out stay as they are.",
				"properties": {
					"title": {
						"type": "string",
						"example": "My edited memo",
						"minLength": 3,
						"maxLength": 128
					},
					"content": {
						"type": "string",
						"example": "This is the edited content of my memo.",
						"minLength": 3,
						"maxLength": 10000
					},
					"tags": {
						"items": {
							"$ref": "#/components/schemas/TagName"
						},
						"type": "array",
						"description": "The memo's new tags, replacing all current ones. An empty list removes them all.\nDuplicates (ignoring case) are merged.",
						"example": [
							"groceries",
							"home"
						],
						"maxItems": 10
					}
				},
				"type": "object",
				"additionalProperties": false
			},
			"MemoTagsUpdateRequest": {
				"properties": {
					"tags": {
						"items": {
							"$ref": "#/components/schemas/TagName"
						},
						"type": "array",
						"description": "The memo's new tags, replacing all current ones. An empty list removes them all.",
						"example": [
							"groceries",
							"home"
						],
						"maxItems": 10
					}
				},
				"required": [
					"tags"
				],
				"type": "object",
				"additionalProperties": false
			},
			"MemoOnUserCreateRequest": {
				"properties": {
					"memoUuid": {
						"type": "string",
						"example": "123e4567-e89b-12d3-a456-426614174000",
						"pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
					},
					"userUuid": {
						"type": "string",
						"example": "9b2d7c1e-4f3a-4b6c-9d8e-7f6a5b4c3d2e",
						"pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
					},
					"role": {
						"type": "string",
						"enum": [
							"USER",
							"MOD",
							"ADMIN"
						],
						"description": "The assignee's role on the memo. Defaults to USER. Only the memo's ADMINs can\nassign MOD or ADMIN.",
						"example": "USER"
					}
				},
				"required": [
					"memoUuid",
					"userUuid"
				],
				"type": "object",
				"additionalProperties": false
			},
			"RegisterRequest": {
				"properties": {
					"username": {
						"type": "string",
						"example": "newuser",
						"minLength": 3,
						"maxLength": 64
					},
					"password": {
						"type": "string",
						"example": "secret123",
						"minLength": 6,
						"maxLength": 72
					},
					"email": {
						"type": "string",
						"example": "user@example.com",
						"format": "email",
						"maxLength": 128,
						"pattern": "^(.+)@(.+)\\.(.+)$"
					},
					"displayName": {
						"type": "string",
						"nullable": true,
						"example": "John Doe",
						"maxLength": 64
					}
				},
				"required": [
					"username",
					"password",
					"email"
				],
				"type": "object",
				"additionalProperties": false
			},
			"AuthResponse": {
				"properties": {
					"accessToken": {
						"type": "string",
						"example": "eyJhbGciOiJI..."
					},
					"accessTokenExpiresOn": {
						"type": "number",
						"format": "double",
						"example": 1772719299
					},
					"refreshTokenExpiresOn": {
						"type": "number",
						"format": "double",
						"example": 1773324099
					}
				},
				"required": [
					"accessToken",
					"accessTokenExpiresOn",
					"refreshTokenExpiresOn"
				],
				"type": "object",
				"additionalProperties": false
			},
			"LoginRequest": {
				"properties": {
					"username": {
						"type": "string",
						"example": "admin",
						"minLength": 1,
						"maxLength": 64
					},
					"password": {
						"type": "string",
						"example": "admin",
						"minLength": 1,
						"maxLength": 72
					}
				},
				"required": [
					"username",
					"password"
				],
				"type": "object",
				"additionalProperties": false
			}
		},
		"securitySchemes": {
			"jwt": {
				"type": "apiKey",
				"name": "Authorization",
				"in": "header"
			}
		}
	},
	"info": {
		"title": "insane-node-rest-api",
		"version": "1.0.0",
		"description": "A compact, fully-typed REST API starter using Node.js, TypeScript, Express, Prisma (MySQL/MariaDB), and tsoa for OpenAPI generation.",
		"license": {
			"name": "MIT"
		},
		"contact": {
			"name": "lucasdee"
		}
	},
	"paths": {
		"/users": {
			"get": {
				"operationId": "SearchUsers",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/UserSummary"
									},
									"type": "array"
								}
							}
						}
					}
				},
				"description": "Lists other users, ordered by username, for example to pick whom to assign a memo to.\nOnly uuid, username and display name are returned. You are never in the list.",
				"tags": [
					"Users"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": [
					{
						"description": "Only users whose username or display name contains this, ignoring case.",
						"in": "query",
						"name": "search",
						"required": false,
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 64
						}
					},
					{
						"description": "How many users to return, 20 by default.",
						"in": "query",
						"name": "limit",
						"required": false,
						"schema": {
							"format": "int32",
							"type": "integer",
							"minimum": 1,
							"maximum": 50
						}
					},
					{
						"description": "How many users to skip, for paging.",
						"in": "query",
						"name": "offset",
						"required": false,
						"schema": {
							"format": "int32",
							"type": "integer",
							"minimum": 0
						}
					}
				]
			}
		},
		"/users/me": {
			"get": {
				"operationId": "GetProfile",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/User"
								}
							}
						}
					},
					"404": {
						"description": "User not found"
					}
				},
				"tags": [
					"Users"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": []
			}
		},
		"/tags": {
			"get": {
				"operationId": "ListMyTags",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/TagCount"
									},
									"type": "array"
								}
							}
						}
					}
				},
				"description": "Lists the tags on memos assigned to you, sorted by name, with how many of them carry each.",
				"tags": [
					"Tags"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": []
			}
		},
		"/memos": {
			"get": {
				"operationId": "ListMyMemos",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/MemoOnUser"
									},
									"type": "array"
								}
							}
						}
					}
				},
				"description": "Lists the memos assigned to you, optionally filtered by tags.",
				"tags": [
					"Memos"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": [
					{
						"description": "Only memos with these tags. Repeat the parameter for several: `?tags=a&tags=b`.",
						"in": "query",
						"name": "tags",
						"required": false,
						"schema": {
							"type": "array",
							"items": {
								"$ref": "#/components/schemas/TagName"
							},
							"maxItems": 10
						}
					},
					{
						"description": "`all` (the default): memos carrying every given tag. `any`: memos carrying at least one.",
						"in": "query",
						"name": "match",
						"required": false,
						"schema": {
							"type": "string",
							"enum": [
								"all",
								"any"
							]
						}
					}
				]
			}
		},
		"/memos/create": {
			"post": {
				"operationId": "CreateMemo",
				"responses": {
					"201": {
						"description": "Created",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Memo"
								}
							}
						}
					}
				},
				"tags": [
					"Memos"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/MemoCreateRequest"
							}
						}
					}
				}
			}
		},
		"/memos/{memoUuid}": {
			"get": {
				"operationId": "GetMemo",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/MemoOnUser"
								}
							}
						}
					},
					"403": {
						"description": "Memo not found or you do not have access to it"
					}
				},
				"description": "Returns your assignment to a memo, with the memo.",
				"tags": [
					"Memos"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "memoUuid",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			},
			"patch": {
				"operationId": "UpdateMemo",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Memo"
								}
							}
						}
					},
					"403": {
						"description": "Memo not found or you do not have access to it, or you are neither its author nor one of its ADMINs or MODs"
					}
				},
				"description": "Changes a memo's title, content and tags. Fields left out stay as they are. Only\nthe memo's author, ADMINs and MODs can do this.",
				"tags": [
					"Memos"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "memoUuid",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/MemoUpdateRequest"
							}
						}
					}
				}
			},
			"delete": {
				"operationId": "DeleteMemo",
				"responses": {
					"204": {
						"description": "No content"
					},
					"403": {
						"description": "Memo not found or you do not have access to it, or you are neither its author nor one of its ADMINs"
					}
				},
				"description": "Deletes a memo for everyone it is assigned to, with its assignments and tag links.\nOnly the memo's author and ADMINs can do this.",
				"tags": [
					"Memos"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "memoUuid",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		},
		"/memos/{memoUuid}/assignments": {
			"get": {
				"operationId": "ListMemoAssignments",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/MemoAssignment"
									},
									"type": "array"
								}
							}
						}
					},
					"403": {
						"description": "Memo not found or you do not have access to it"
					}
				},
				"description": "Lists everyone a memo is assigned to, with their role on it and who assigned them,\noldest assignment first. Anyone with access to the memo can do this.",
				"tags": [
					"Memos"
				],
				"security": [
					{
						"jwt": []
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "memoUuid",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		},
		"/memos/{memoUuid}/tags": {
			"put": {
				"operationId": "ReplaceMemoTags",
				"responses": {
					"200": {
