# development (default), production or test. production adds Secure to the refresh
# cookie and turns off /docs and the console request log; test turns off both logs.
NODE_ENV=development
PORT=3000
# Origin of the frontend that calls the API (here a Vite dev server). One origin only.
CORS_ORIGIN=http://localhost:5173
# Use three different long random values, e.g. from `openssl rand -hex 32`. If
# JWT_SECRET equals JWT_REFRESH_SECRET, a refresh token also passes as an access token.
JWT_SECRET=super-secret
JWT_REFRESH_SECRET=super-refresh-secret
JWT_REFRESH_HASH_SECRET=super-refresh-hash-secret
JWT_ACCESS_TOKEN_EXPIRES_IN_MINUTES=5
JWT_REFRESH_TOKEN_EXPIRES_IN_DAYS=7
DATABASE_USER=db_user
DATABASE_PASSWORD=db_password
DATABASE_NAME=db_name
DATABASE_HOST=db_host
DATABASE_PORT=3306
# Used by `prisma migrate dev`. Required, although the app itself doesn't use it.
SHADOW_DATABASE_NAME=shadow_db_name

# Optional
# Serve Swagger UI at /docs. Defaults to true, except when NODE_ENV=production.
# DOCS_ENABLED=false
# Access log file, rotated daily. Defaults to true, except when NODE_ENV=test.
# ACCESS_LOG_ENABLED=true
# Folder for access.log, relative to the working directory. Defaults to logs.
# ACCESS_LOG_DIR=logs
# Behind a reverse proxy: number of proxy hops (e.g. 1), or trusted addresses/subnets.
# Unset trusts no proxy. Avoid `true`, which lets clients spoof their IP.
# TRUST_PROXY=1
# Requests per client IP: login per 15 min, register per hour, refresh per 15 min.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REFRESH_MAX=60
