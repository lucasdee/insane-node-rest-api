// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  MOD
  ADMIN
}

model User {
  @@map ("users")
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  uuid          String    @unique @default(uuid()) @db.Char(36)
  username      String    @unique @db.VarChar(64)
  password      String
  email         String    @unique @db.VarChar(128)
  displayName   String?   @db.VarChar(64)
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  refreshTokens RefreshToken[]
  memos         MemoOnUser[]
  memosAuthored Memo[]
  memosAssigned MemoOnUser[] @relation("assignedBy")
}

model RefreshToken {
  @@map("refresh_tokens")
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash String   @unique @db.VarChar(128)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @db.UnsignedInt
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Set once the token has been rotated. It is kept until it expires, so that reusing
  // it can be detected and its whole family revoked.
  revoked   Boolean  @default(false)
  // Shared by every token rotated from the same login, i.e. one device's session.
  familyId  String   @db.Char(36)

  @@index([familyId])
}

model Memo {
  @@map ("memos")
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  uuid      String    @unique @default(uuid()) @db.Char(36)
  title     String    @db.VarChar(128)
  content   String    @db.Text
  author    User      @relation(fields: [authorId], references: [id])
  authorId  Int       @db.UnsignedInt
  createdAt DateTime  @default(now())
  users     MemoOnUser[]
  tags      MemoOnTag[]
}

model MemoOnUser {
  @@map ("memos_on_users")
  // Deleting a memo removes its assignments.
  memo          Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId        Int      @db.UnsignedInt
  user          User     @relation(fields: [userId], references: [id])
  userId        Int      @db.UnsignedInt
  assignedAt    DateTime @default(now())
  assignedBy    User     @relation("assignedBy", fields: [assignedById], references: [id])
  assignedById  Int     @db.UnsignedInt
  role          Role     @default(USER)
  @@id([memoId, userId])
}

model Tag {
  @@map ("tags")
  id    Int         @id @default(autoincrement()) @db.UnsignedInt
  // Stored lowercased by the service, so a tag is unique regardless of case.
  name  String      @unique @db.VarChar(32)
  memos MemoOnTag[]
}

model MemoOnTag {
  @@map ("memos_on_tags")
  memo   Memo @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId Int  @db.UnsignedInt
  tag    Tag  @relation(fields: [tagId], references: [id])
  tagId  Int  @db.UnsignedInt
  @@id([memoId, tagId])
  // Finds a tag's memos when filtering by tag; the primary key covers memo -> tags.
  @@index([tagId])
}
